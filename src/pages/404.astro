---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
---

<Layout
  title="Page Not Found | Manchester Gutters"
  description="The page you were looking for has moved or does not exist. Browse our roofing and guttering services across Manchester or request a free quote."
  noindex
>
  <Header />

  <main>
    <section class="page-hero">
      <div class="container">
        <h1>Page Not Found</h1>
        <p>That page has moved or no longer exists. These links will get you back on track.</p>
      </div>
    </section>

    <section class="section">
      <div class="container not-found">
        <h2>Where to next?</h2>
        <ul>
          <li><a href="/services/">Roofing and guttering services in Manchester</a></li>
          <li><a href="/about/">About Manchester Gutters</a></li>
          <li><a href="/reviews/">Customer reviews</a></li>
          <li><a href="/gallery/">Our recent work</a></li>
          <li><a href="/contact/">Contact us for a free quote</a></li>
        </ul>
        <p><a class="btn btn-primary" href="/">Back to the homepage</a></p>
      </div>
    </section>
  </main>

  <Footer />
  <FloatingCTA />
</Layout>

<style>
  .not-found ul { margin: 1rem 0 1.5rem; padding-left: 1.25rem; }
  .not-found li { margin-bottom: 0.5rem; }
</style>
