---
import tracking from '../data/tracking.json';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  schema?: object | object[];
  noindex?: boolean;
}

const siteUrl = 'https://manchestergutters.co.uk';
const {
  title = "Manchester Gutters | Gutter & Roof Repairs in Manchester",
  description = "Gutter repairs, replacement and cleaning, fascias, soffits and roof repairs across Manchester and Greater Manchester. Free, no-obligation quotes.",
  ogImage = "/images/hero-bg.jpg",
  schema,
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const gtmOn = Boolean(tracking.gtm.enabled && tracking.gtm.containerId);
// GTM carries GA4 when it is on, so GA4 loads directly only without GTM.
const ga4On = Boolean(!gtmOn && tracking.ga4.enabled && tracking.ga4.measurementId);
// Clarity is a tag inside the GTM container; loading it here as well would run it twice.
const clarityOn = Boolean(!gtmOn && tracking.clarity.enabled && tracking.clarity.projectId);
const ogImageUrl = new URL(ogImage, siteUrl).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="google-site-verification" content="Gb9qIsbU0dDuIJlImjHpvlxi8EoEFt91qSHtzzWgsg0" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph (Facebook, WhatsApp, LinkedIn) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="Manchester Gutters" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Geo tags for local SEO -->
    <meta name="geo.region" content="GB-MAN" />
    <meta name="geo.placename" content="Manchester" />

    <!-- Fonts (reduced weights, swap for faster LCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Roboto:wght@400;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;700&family=Roboto:wght@400;700&display=swap" rel="stylesheet" />

    {/* Tracking: one external file sets consent defaults first, then loads GTM (or GA4) and,
        only after a yes, Clarity. IDs come from tracking.json. No inline scripts: the security
        header in public/_headers blocks them. */}
    {(gtmOn || ga4On || clarityOn) && (
      <script
        is:inline
        src="/js/consent-tracking.js"
        data-gtm={gtmOn ? tracking.gtm.containerId : undefined}
        data-ga4={ga4On ? tracking.ga4.measurementId : undefined}
        data-clarity={clarityOn ? tracking.clarity.projectId : undefined}
        data-mode={tracking.consent?.mode ?? 'basic'}
      ></script>
    )}

    <!-- Schema / Structured Data (JSON-LD) -->
    {schema && (
      Array.isArray(schema)
        ? schema.map(s => <script type="application/ld+json" set:html={JSON.stringify(s)} />)
        : <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <slot />
    <script>
      // Shows the placeholder beside any photo that fails to load (some project photos are
      // still to come). Replaces inline onerror handlers, which the security header blocks.
      function showFallback(img: HTMLImageElement) {
        img.style.display = 'none';
        const placeholder = img.nextElementSibling as HTMLElement | null;
        if (placeholder) placeholder.style.display = 'flex';
      }
      document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach((img) => {
        if (img.complete && img.naturalWidth === 0) showFallback(img);
        else img.addEventListener('error', () => showFallback(img));
      });
    </script>
  </body>
</html>

<style is:global>
  .cookie-banner {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: 16px;
    z-index: 1000;
    max-width: 640px;
    margin: 0 auto;
    padding: 16px 20px;
    background: #1a1a1a;
    color: #fff;
    border-radius: 8px;
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.3);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .cookie-banner[hidden] { display: none; }
  .cookie-banner__actions {
    display: flex;
    gap: 12px;
    justify-content: flex-end;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .cookie-banner__btn {
    min-width: 140px;
    padding: 10px 16px;
    border: 2px solid #fff;
    border-radius: 4px;
    background: transparent;
    color: #fff;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .cookie-banner__btn:hover,
  .cookie-banner__btn:focus-visible {
    background: #fff;
    color: #1a1a1a;
  }

  *,
  *::before,
  *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --red: #C8102E;
    --red-dark: #A00D24;
    --dark: #1A1A1A;
    --dark-bg: #111111;
    --yellow: #FBBC04;
    --yellow-hover: #E5A800;
    --light-gray: #F5F5F5;
    --medium-gray: #E0E0E0;
    --text-gray: #555555;
    --white: #FFFFFF;
    --green: #25D366;
    --max-width: 1200px;
    --header-height: 80px;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: 'Roboto', Arial, sans-serif;
    color: var(--dark);
    line-height: 1.6;
    overflow-x: hidden;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Oswald', sans-serif;
    font-weight: 700;
    line-height: 1.2;
  }

  a {
    text-decoration: none;
    color: inherit;
  }

  ul {
    list-style: none;
  }

  img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .container {
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 20px;
  }

  .section {
    padding: 80px 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 50px;
  }

  .section-header h2 {
    font-size: 2.5rem;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .section-header .red-line {
    width: 60px;
    height: 4px;
    background: var(--red);
    margin: 15px auto;
    border-radius: 2px;
  }

  .section-header p {
    color: var(--text-gray);
    font-size: 1.1rem;
    max-width: 600px;
    margin: 0 auto;
  }

  .btn {
    display: inline-block;
    padding: 14px 32px;
    font-family: 'Oswald', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-primary {
    background: var(--yellow);
    color: var(--dark);
  }

  .btn-primary:hover {
    background: var(--yellow-hover);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(251, 188, 4, 0.4);
  }

  .btn-red {
    background: var(--red);
    color: var(--white);
  }

  .btn-red:hover {
    background: var(--red-dark);
    transform: translateY(-2px);
    box-shadow: 0 4px 15px rgba(200, 16, 46, 0.4);
  }

  .btn-outline {
    background: transparent;
    color: var(--white);
    border: 2px solid var(--white);
  }

  .btn-outline:hover {
    background: var(--white);
    color: var(--dark);
  }

  @media (max-width: 768px) {
    .section {
      padding: 50px 0;
    }

    .section-header h2 {
      font-size: 1.8rem;
    }
  }
</style>
